# yesuvd.tech — Portfolio (Next.js + MongoDB, ~/portfolio).
#
# 80 портын шилжүүлэг ба ACME-ийн шалгалт нь default.conf доторх нийтлэг
# блокт байдаг тул энд зөвхөн 443 хэрэгтэй. Хязгаарын зонууд 00-rate-limit.conf-д.
server {
    listen 443 ssl;
    http2 on;
    server_name www.${PORTFOLIO_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PORTFOLIO_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PORTFOLIO_DOMAIN}/privkey.pem;

    return 301 https://${PORTFOLIO_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PORTFOLIO_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PORTFOLIO_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PORTFOLIO_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Зураг, CV хуулалт (апп дотор 4MB хязгаартай)
    client_max_body_size 5m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    # portfolio container унтарсан үед ч nginx асаж чадахаар Docker DNS-ээр хандана
    resolver 127.0.0.11 valid=30s;
    set $portfolio http://portfolio:3000;

    # Admin нууц үг таах оролдлогын хязгаар
    location = /api/auth {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $portfolio;
    }

    location / {
        limit_req zone=api burst=60 nodelay;
        proxy_pass $portfolio;
    }
}
